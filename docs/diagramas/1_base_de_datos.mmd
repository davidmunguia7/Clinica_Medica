    consultas_consulta ||--o{ consultas_medicamentorecetado : "consulta_id"
    consultas_medicamentorecetado ||--o{ consultas_medicamentorecetado_movimientos : "medicamentorecetado_id"
    inventario_categoria |o--o{ inventario_producto : "categoria_id"
    inventario_producto |o--o{ consultas_medicamentorecetado : "producto_id"
    inventario_producto ||--o{ inventario_lote : "producto_id"
    inventario_producto ||--o{ inventario_movimiento : "producto_id"
    inventario_lote ||--o{ inventario_movimiento : "lote_id"
