# Copia este archivo como .env y cambia los valores por los de tu computadora.
# El .env NO se sube a GitHub (ya está en .gitignore).
DB_NAME=clinica_familiar
DB_HOST=NOMBRE-DE-TU-PC\SQLEXPRESS

# Clave para cifrar los datos sensibles de los pacientes (Fernet).
# Genérenla con:  python manage.py generar_clave_cifrado --guardar
# Cada computadora tiene la suya; si se pierde, no se pueden leer esos datos.
CLAVE_CIFRADO=

# Recordatorios por SMS. Por ahora se simulan (no hace falta cambiar nada).
# Para enviarlos de verdad con Twilio, descomenten y llenen:
# SMS_BACKEND=citas.sms.BackendTwilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_NUMERO=+1XXXXXXXXXX
# Teléfono de la clínica que aparece en el mensaje:
CLINICA_TELEFONO=
